<?xml version="1.0" encoding="UTF-8"?>
<xml-fragment xmlns:ser="http://www.bea.com/wli/sb/services"
              xmlns:tran="http://www.bea.com/wli/sb/transports"
              xmlns:env="http://www.bea.com/wli/sb/services/security/environment"
              xmlns:http="http://www.bea.com/wli/sb/transports/http"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ser:coreEntry isProxy="true" isEnabled="true">
        <ser:binding type="SOAP" isSoap12="false" xsi:type="con:SoapBindingType"
                     xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
            <con:wsdl ref="RNU-AtribuicaoMedico/WSDL/AtribuicaoMedico"/>
            <con:binding>
                <con:name>AtribuicaoMedicoBinding</con:name>
                <con:namespace>http://igif.min-saude.pt/rnu/atribuicaomedico</con:namespace>
            </con:binding>
        </ser:binding>
        <ser:monitoring isEnabled="true">
            <ser:aggregationInterval>10</ser:aggregationInterval>
            <ser:pipelineMonitoringLevel>Pipeline</ser:pipelineMonitoringLevel>
        </ser:monitoring>
        <ser:reporting>true</ser:reporting>
        <ser:logging isEnabled="true">
            <ser:logLevel>debug</ser:logLevel>
        </ser:logging>
        <ser:sla-alerting isEnabled="true">
            <ser:sla-alert-rule>
                <ser:name>SLA_AtribuicaoMedico</ser:name>
                <ser:isActive>true</ser:isActive>
                <ser:condition>
                    <ser:metric>response-time</ser:metric>
                    <ser:operator>GT</ser:operator>
                    <ser:value>5000</ser:value>
                </ser:condition>
                <ser:alert-destination>
                    <ser:name>AlertDestination</ser:name>
                </ser:alert-destination>
            </ser:sla-alert-rule>
        </ser:sla-alerting>
        <ser:ws-policy>
            <ser:binding-mode>wsdl-policy-attachments</ser:binding-mode>
        </ser:ws-policy>
    </ser:coreEntry>
    <ser:endpointConfig>
        <tran:provider-id>http</tran:provider-id>
        <tran:inbound>true</tran:inbound>
        <tran:URI>
            <tran:value>/RNU-AtribuicaoMedico/ProxyService/AtribuicaoMedico_PS</tran:value>
        </tran:URI>
        <tran:inbound-properties/>
        <tran:all-headers>false</tran:all-headers>
        <tran:provider-specific xsi:type="http:HttpEndPointConfiguration">
            <http:inbound-properties>
                <http:request-encoding>UTF-8</http:request-encoding>
                <http:response-encoding>UTF-8</http:response-encoding>
            </http:inbound-properties>
        </tran:provider-specific>
    </ser:endpointConfig>
    <ser:router>
        <ser:pipeline ref="RNU-AtribuicaoMedico/Pipeline/AtribuicaoMedico_PL"/>
    </ser:router>
</xml-fragment>
