                  xmlns:tns="http://igif.min-saude.pt/rnu/atribuicaomedico"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  name="AtribuicaoMedicoService"
                  targetNamespace="http://igif.min-saude.pt/rnu/atribuicaomedico">

    <!-- Types -->
    <wsdl:types>
        <xsd:schema>
            <xsd:import namespace="http://igif.min-saude.pt/rnu/atribuicaomedico"
                        schemaLocation="../XSD/AtribuicaoMedico.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- Messages -->
    <wsdl:message name="AtribuicaoMedicoRequestMessage">
        <wsdl:part name="parameters" element="tns:AtribuicaoMedicoRequest"/>
    </wsdl:message>

    <wsdl:message name="AtribuicaoMedicoResponseMessage">
        <wsdl:part name="parameters" element="tns:AtribuicaoMedicoResponse"/>
    </wsdl:message>

    <!-- Port Type -->
    <wsdl:portType name="AtribuicaoMedicoPortType">
        <wsdl:operation name="AtribuicaoMedico">
            <wsdl:input message="tns:AtribuicaoMedicoRequestMessage"/>
            <wsdl:output message="tns:AtribuicaoMedicoResponseMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- Binding -->
    <wsdl:binding name="AtribuicaoMedicoBinding" type="tns:AtribuicaoMedicoPortType">
