            <soap:operation soapAction="http://igif.min-saude.pt/rnu/atribuicaomedico/AtribuicaoMedico"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <!-- Service -->
    <wsdl:service name="AtribuicaoMedicoService">
        <wsdl:port name="AtribuicaoMedicoPort" binding="tns:AtribuicaoMedicoBinding">
            <soap:address location="http://localhost:7001/OSB-RNU-AtribuicaoMedico-context-root/AtribuicaoMedicoService"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
